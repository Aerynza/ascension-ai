# Ascension AI - Environment Variables

# Database
DATABASE_URL=postgresql://localhost:5432/ascension_ai

# Server
PORT=3000

# Private standalone evaluation service.
# Service routes accept ASCENSION_AI_SERVICE_TOKEN or the AERYNZA_AI_SERVICE_TOKEN alias.
# ASCENSION_AI_ALLOWED_EMAIL does not authenticate.
ASCENSION_AI_SERVICE_TOKEN=generate_a_long_random_private_value
AERYNZA_AI_SERVICE_TOKEN=
ASCENSION_AI_AUTH_MODE=production
ASCENSION_MODEL_PROFILE=starter
ASCENSION_MODEL_CONTEXT=768
ASCENSION_MODEL_BATCH=16
ASCENSION_MODEL_THREADS=1
# 256 MiB. The starter GGUF fits. pro_v231 does not.
AERYNZA_AI_RAM_BUDGET_BYTES=268435456
ASCENSION_VERIFY_MODEL_ON_BOOT=1
ASCENSION_AI_ALLOWED_ORIGINS=
AERYNZA_AI_ENABLE_DEVICE_ROUTES=0
AERYNZA_AI_ENABLE_PROVIDER_ROUTES=0
